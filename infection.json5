{
    "$schema": "https://raw.githubusercontent.com/infection/infection/master/resources/schema.json",
    "source": {
        "directories": [
            "Controller",
            "Entity",
            "EventListener",
            "Import",
            "Payload",
            "Settings"
        ]
    },
    "phpUnit": {
        "configDir": ".",
        "customPath": "../../bin/phpunit"
    },
    "tmpDir": "../../var/cache/infection-rge-studio-connector",
    "logs": {
        "text": "../../var/logs/infection-rge-studio-connector.log",
        "summary": "../../var/logs/infection-rge-studio-connector-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 94,
    "minCoveredMsi": 94
}
